    "findings": [
      {
        "priority": "P1",
        "title": "Run preparation loads and retains the whole transcript",
        "sources": [
          "src/core/kernel/run-setup.ts:35",
          "src/runtime/engine.ts:113",
          "src/core/context.ts:146"
        ],
        "suggestion": "Persist a validated summary boundary/cursor; load summary plus recent atomic conversation groups, repairing unfinished tail calls and retaining original history in SQLite."
      },
      {
        "priority": "P1",
        "title": "Asset upload and download fully materialize buffers",
        "sources": [
          "src/api/shared.ts:26",
          "src/api/routes/resources.ts:98",
          "src/storage/assets.ts:107"
        ],
        "suggestion": "Stream uploads through a bounded hash/size pipeline to a temporary file and atomically publish; stream verified downloads while preserving current integrity checks and cancellation cleanup; add aggregate in-flight byte limits."
      },
      {
        "priority": "P2",
        "title": "Several API lists and the runs array in session details have no page limit",
        "sources": [
          "src/api/routes/sessions.ts:45",
          "src/api/routes/sessions.ts:87",
          "src/api/routes/resources.ts:32",
          "src/storage/store.ts:346"
        ],
        "suggestion": "Add bounded cursor pages and lightweight projections to list routes; use existing Store pagination rather than slicing after loading."
      },
      {
        "priority": "P2",
        "title": "Pruning drains every batch in one synchronous event-loop turn",
        "sources": [
          "src/storage/store.ts:741",
          "src/core/kernel.ts:264"
        ],
        "suggestion": "Apply a per-tick batch/time budget and yield between transactions; retain a cursor and report cleanup errors."
      },
      {
        "priority": "P2",
        "title": "Input queues and total SSE subscription buffering lack aggregate capacity limits",
        "sources": [
          "src/runtime/engine.ts:146",
          "src/runtime/keyed-queue.ts:12",
          "src/api/events.ts:79"
        ],
        "suggestion": "Bound queued inputs by count and byte size; cap per-run/host subscribers and aggregate stream bytes, with capacity rejection before expensive preparation."
      },
      {
        "priority": "P2",
        "title": "Tests are transpiled without semantic typechecking and release verification omits lint/format gates",
        "sources": [
          "scripts/run-core-tests.mjs:46",
          "scripts/verify-release.mjs:12",
          "tsconfig.json:16"
        ],
        "suggestion": "Add a dedicated strict tests/examples configuration, improve typed fixture/client results, and run type/lint/format/test checks in CI."
      },
      {
        "priority": "P2-conditional",
        "title": "Redaction configuration and credential registrations are process-wide across Kernel instances",
        "sources": [
          "src/core/util.ts:17",
          "src/core/util.ts:155",
          "src/core/kernel.ts:170"
        ],
        "suggestion": "Use per-kernel redaction context and lifecycle-managed secret ownership if multiple kernels with different policies are needed in the same process."
      },
      {
        "priority": "P3",
        "title": "Large orchestration modules and broad SDK root import graph leave maintainability/startup opportunities",
        "sources": [
          "src/core/kernel.ts",
          "src/extensions/mcp/manager.ts",
          "src/index.ts"
        ],
        "suggestion": "Extract stable responsibilities as features change; profile feature-level lazy assembly before changing public entry points or dependencies."
      }
    ],
    "limitations": [
      "The 200-message and 100-row windows measure available storage operations; they are not behavior-equivalent replacements for history repair or an unpaginated API.",
      "Single-process allocation deltas are not production RSS forecasts or leak tests.",
